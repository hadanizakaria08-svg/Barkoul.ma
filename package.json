{
  "name": "barkoul-ma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @barkoul/web",
    "build": "npm run build --workspace @barkoul/web",
    "typecheck": "npm run typecheck --workspace @barkoul/web",
    "test": "npm run test --workspace @barkoul/domain",
    "check": "npm run typecheck && npm run test && npm run build",
    "mobile:sync": "cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  }
}