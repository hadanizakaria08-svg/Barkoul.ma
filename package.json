{
  "name": "barkoul-ma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @barkoul/web",
    "build": "npm run build --workspace @barkoul/web",
    "typecheck": "npm run typecheck --workspace @barkoul/web",
    "test": "npm run test --workspace @barkoul/domain",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "mobile:sync": "cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@capacitor/android": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@playwright/test": "^1.56.1"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.10"
  },
  "overrides": {
    "picomatch": "^4.0.7",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}