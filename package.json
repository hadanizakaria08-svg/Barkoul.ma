{
  "name": "barkoul-ma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @barkoul/web",
    "build": "npm run build --workspace @barkoul/web",
    "typecheck": "npm run typecheck --workspace @barkoul/web",
    "test": "npm run test --workspace @barkoul/domain && node --test scripts/service-worker.test.mjs scripts/security-migrations.test.mjs scripts/rpc-contracts.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "security:runtime-deps": "node scripts/check-runtime-dependency-boundary.mjs",
    "mobile:sync": "cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "security:source": "node scripts/check-source-security.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@capacitor/android": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.25.12"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.10"
  }
}
