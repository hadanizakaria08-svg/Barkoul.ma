{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Barkoul.ma",
  "version": "0.1.0",
  "identifier": "ma.barkoul.app",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @barkoul/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace @barkoul/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Barkoul.ma",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": []
  }
}